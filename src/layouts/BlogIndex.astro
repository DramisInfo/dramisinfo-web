---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ui, type Lang } from '@/i18n/ui';
import { getPosts, readingTime, formatDate } from '@/lib/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const b = t.blog;
const posts = await getPosts(lang);
const base = lang === 'fr' ? '/blogue/' : '/en/blog/';
const rss = lang === 'fr' ? '/rss.xml' : '/en/rss.xml';

// L'index est trié du plus récent au plus ancien — ce que tout lecteur attend.
// Mais l'ordre de parution n'est pas toujours l'ordre du récit : on peut donc
// désigner un point d'entrée. Résolu contre les articles réellement publiés,
// pour qu'un identifiant périmé ne laisse jamais un lien mort.
const startHere = b.startHereId ? posts.find((p) => p.id === b.startHereId) : undefined;
---
<BaseLayout lang={lang} title={b.metaTitle} description={b.metaDescription}>
  <Header lang={lang} />

  <main id="main">
    <section class="border-b border-rule py-20 md:py-24">
      <div class="page grid gap-x-10 md:grid-cols-[7rem_1fr]">
        <div class="mb-6 font-mono text-[11px] uppercase tracking-label text-ink-3 md:mb-0 md:pt-3">
          <span class="tnum text-accent">{b.num}</span>
          <span class="ml-3 md:ml-0 md:mt-1 md:block">{b.label}</span>
        </div>
        <div>
          <h1 class="text-[38px] leading-[1.1] sm:text-[50px]">{b.title}</h1>
          <p class="mt-6 max-w-prose text-[17.5px] leading-relaxed text-ink-2">{b.lead}</p>
          {startHere && (
            <p class="mt-7 max-w-prose border-l-2 border-accent pl-4 text-[15px] leading-relaxed text-ink-3">
              {b.startHere}{' '}
              <a
                href={`${base}${startHere.id}/`}
                class="text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-deep hover:decoration-accent"
              >
                {startHere.data.title}
              </a>
            </p>
          )}
          <a href={rss} class="mt-7 inline-block font-mono text-[12px] uppercase tracking-label text-accent hover:text-accent-deep">
            {b.rss}
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="page">
        {posts.length === 0 ? (
          <p class="font-mono text-[13px] text-ink-3">{b.empty}</p>
        ) : (
          <ol>
            {posts.map((post) => (
              <li class="border-t border-rule last:border-b">
                <a href={`${base}${post.id}/`} class="group grid gap-x-10 gap-y-2 py-8 md:grid-cols-[7rem_1fr]">
                  <div class="font-mono text-[11.5px] uppercase tracking-label text-ink-3 tnum md:pt-1.5">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate, lang)}
                    </time>
                    {post.data.draft && (
                      <span class="ml-3 text-accent md:ml-0 md:mt-1 md:block">Brouillon</span>
                    )}
                  </div>
                  <div>
                    <h2 class="text-[23px] font-semibold leading-snug transition-colors group-hover:text-accent">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 max-w-prose text-[16px] leading-relaxed text-ink-3">
                      {post.data.description}
                    </p>
                    <p class="mt-3 font-mono text-[11.5px] uppercase tracking-label text-ink-4 tnum">
                      {readingTime(post.body)} {b.readingTime}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
