---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].how;
---
<section id="demarche" class="relative py-24 bg-navy-900 bg-cover bg-center" style="background-image: linear-gradient(180deg, rgba(13,27,62,0.93), rgba(13,27,62,0.93)), url(/images/section-network.jpg);">
  <div class="max-w-6xl mx-auto px-6">
    <div data-reveal class="text-center mb-16">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-brand-400 mb-3">{t.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t.heading}</h2>
      <p class="text-navy-200 text-lg max-w-xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <div data-reveal-group class="grid md:grid-cols-3 gap-8">
      {t.steps.map((step, i) => (
        <div data-reveal class="text-center">
          <div class="w-14 h-14 mx-auto mb-5 flex items-center justify-center rounded-full bg-navy-700 text-brand-400 text-xl font-bold">
            {i + 1}
          </div>
          <h3 class="text-white font-semibold text-lg mb-3">{step.title}</h3>
          <p class="text-navy-200 text-sm leading-relaxed max-w-xs mx-auto">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
