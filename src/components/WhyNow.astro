---
import SectionHead from './SectionHead.astro';
import { ui, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].why;
---
<section id="pourquoi" class="bg-ink py-20 text-white md:py-28">
  <div class="page">
    <SectionHead num={t.num} label={t.label} title={t.title} lead={t.lead} tone="paper" />

    <dl data-reveal class="mt-14 grid gap-px border border-rule-dark bg-rule-dark sm:grid-cols-3">
      {t.figures.map((f) => (
        <div class="bg-ink px-6 py-8">
          <dt class="font-display text-[46px] font-bold leading-none tracking-tight text-white tnum">
            {f.value}<span class="ml-1 text-[18px] font-medium text-accent">{f.unit}</span>
          </dt>
          <dd class="mt-4 text-[14px] leading-snug text-white/55">{f.caption}</dd>
        </div>
      ))}
    </dl>

    <p data-reveal class="mt-5 max-w-prose font-mono text-[12.5px] leading-relaxed text-white/45">
      {t.figuresNote}
    </p>

    <div class="mt-14 grid gap-x-12 md:grid-cols-3">
      {t.points.map((p) => (
        <div data-reveal class="border-t border-rule-dark py-7">
          <h3 class="text-[17px] font-semibold leading-snug text-white">{p.title}</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-white/60">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
