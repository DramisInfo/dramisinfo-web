---
import { render, type CollectionEntry } from 'astro:content';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = ui[lang].blog;
const home = lang === 'fr' ? '/' : '/en/';
const locale = lang === 'fr' ? 'fr-CA' : 'en-CA';

const { Content } = await render(post);
const readMin = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).length / 200));
const fmtDate = post.data.pubDate.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<main class="pt-16">
  <article>
    <header class="bg-gradient-to-b from-brand-50 via-warm-50 to-white pt-14 pb-12">
      <div class="max-w-3xl mx-auto px-6">
        <a href={`${home}blog/`} class="inline-flex items-center gap-1.5 text-sm text-brand-600 hover:text-brand-700 font-medium mb-8 transition-colors">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          {t.back}
        </a>
        <div class="flex flex-wrap gap-2 mb-5">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-medium text-brand-700 bg-white border border-brand-100 px-2.5 py-1 rounded-full">{tag}</span>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-warm-900 tracking-tight leading-tight mb-5">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-2 text-sm text-warm-500">
          <span>{t.published} {fmtDate}</span>
          <span aria-hidden="true">•</span>
          <span>{readMin} {t.readTime}</span>
        </div>
      </div>
    </header>

    <div class="max-w-3xl mx-auto px-6 py-12">
      <div class="article-content">
        <Content />
      </div>
    </div>
  </article>

  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-brand-600 rounded-2xl p-8 md:p-10 text-center shadow-lg shadow-brand-900/10">
        <h2 class="text-2xl font-bold text-white mb-3">{t.cta.heading}</h2>
        <p class="text-brand-50 mb-6 max-w-xl mx-auto">{t.cta.text}</p>
        <a href={`${home}#contact`} class="inline-block bg-white text-brand-700 font-semibold px-7 py-3 rounded-xl hover:-translate-y-0.5 hover:shadow-md transition-all">
          {t.cta.button}
        </a>
      </div>
    </div>
  </section>
</main>
