---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---
<footer class="bg-white border-t border-warm-200 py-8">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-warm-600">
    <span>© {year} DramisInfo. {t.rights}</span>
    <span>{t.made} 🇨🇦</span>
  </div>
</footer>
