---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = lang === 'fr' ? '/' : '/en/';
const year = new Date().getFullYear();

const links = [
  { label: t.nav.approach, href: `${home}#demarche` },
  { label: t.nav.services, href: `${home}#services` },
  { label: t.nav.useCases, href: `${home}#cas` },
  { label: t.nav.blog, href: `${home}blog/` },
  { label: t.nav.about, href: `${home}#apropos` },
];
---
<footer class="bg-white border-t border-warm-200 py-10">
  <div class="max-w-6xl mx-auto px-6 flex flex-col gap-6">
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
      {links.map(link => (
        <a href={link.href} class="text-warm-600 hover:text-brand-600 transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-warm-500 border-t border-warm-100 pt-6">
      <span>© {year} DramisInfo. {t.footer.rights}</span>
      <span>{t.footer.made} 🇨🇦</span>
    </div>
  </div>
</footer>
