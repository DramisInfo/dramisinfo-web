---
import Logo from './Logo.astro';
import { ui, coords, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---
<footer class="bg-ink py-14 text-white">
  <div class="page flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <Logo class="text-[19px]" tone="paper" />
      <p class="mt-2 text-[14px] text-white/55">{t.tagline}</p>
      <p class="mt-4 font-mono text-[12.5px] text-white/70">
        {coords.phone && (
          <>
            <a href={coords.phoneHref} class="hover:text-accent">{coords.phone}</a>
            <span class="mx-2 text-white/30">·</span>
          </>
        )}
        <a data-eu={coords.emailUser} data-ed={coords.emailDomain} class="hover:text-accent"></a>
      </p>
    </div>
    <p class="font-mono text-[11.5px] leading-relaxed text-white/40">
      © {year} DramisInfo. {t.rights}<br />{t.made}
    </p>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('a[data-eu][data-ed]').forEach((a) => {
    const addr = a.dataset.eu + '@' + a.dataset.ed;
    a.href = 'mailto:' + addr;
    if (!a.textContent.trim()) a.textContent = addr;
  });
</script>
