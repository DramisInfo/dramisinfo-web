---
import SectionHead from './SectionHead.astro';
import { ui, coords, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].profile;
---
<section id="profil" class="border-b border-rule py-20 md:py-28">
  <div class="page">
    <SectionHead num={t.num} label={t.label} title={t.title} />

    <div class="grid gap-x-10 md:grid-cols-[7rem_1fr]">
      <div></div>
      <div>
        <p data-reveal class="mt-2 font-mono text-[12.5px] uppercase tracking-label text-accent">{t.role}</p>

        <div data-reveal class="mt-7 max-w-prose space-y-4 text-[16.5px] leading-relaxed text-ink-2">
          {t.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-14 grid gap-x-12 gap-y-12 lg:grid-cols-2">
          <div data-reveal>
            <h3 class="label">{t.pathLabel}</h3>
            <ul class="mt-4">
              {t.path.map((row) => (
                <li class="grid grid-cols-[1fr_auto] items-baseline gap-4 border-t border-rule-light py-3.5">
                  <div>
                    <span class="block text-[15px] font-semibold leading-snug">{row.role}</span>
                    <span class="text-[14px] text-ink-3">{row.org}</span>
                  </div>
                  <span class="font-mono text-[12px] text-ink-3 tnum whitespace-nowrap">{row.period}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 font-mono text-[12px] leading-relaxed text-ink-3">{t.pathNote}</p>
          </div>

          <div data-reveal>
            <h3 class="label">{t.proofLabel}</h3>
            <ul class="mt-4">
              {t.proof.map((row) => (
                <li class="border-t border-rule-light py-3.5">
                  <span class="block text-[15px] font-semibold leading-snug">{row.title}</span>
                  <span class="text-[14px] leading-snug text-ink-3">{row.sub}</span>
                </li>
              ))}
            </ul>
            <a
              href={coords.linkedin}
              rel="noopener"
              class="mt-5 inline-block font-mono text-[12.5px] text-accent underline underline-offset-4 hover:text-accent-deep"
            >LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
