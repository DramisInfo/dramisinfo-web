---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].framework;

// Décalage ascendant (escalier) sur grand écran : la productivité qui monte.
const offsets = ['lg:mt-24', 'lg:mt-16', 'lg:mt-8', 'lg:mt-0'];
---
<section id="parcours" class="py-24 bg-gradient-to-b from-white to-brand-50/40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg max-w-2xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:items-start">
      {t.stages.map((stage, i) => (
        <div class={`relative bg-white border border-warm-200 rounded-2xl p-6 shadow-sm hover:border-brand-300 hover:shadow-md transition-all ${offsets[i]}`}>
          <!-- Barre d'accent ascendante -->
          <div class="absolute top-0 left-6 right-6 h-1 rounded-b-full bg-brand-500" style={`opacity:${0.4 + i * 0.2}`}></div>

          <div class="flex items-center justify-between mb-5 mt-2">
            <div class="w-11 h-11 flex items-center justify-center rounded-xl bg-brand-50">
              <Icon name={stage.icon} class="w-6 h-6" />
            </div>
            <span class="text-xs font-semibold text-brand-700 bg-brand-50 px-2.5 py-1 rounded-full">
              {t.levelLabel} {i + 1}
            </span>
          </div>

          <h3 class="text-warm-900 font-semibold text-lg mb-2">{stage.title}</h3>
          <p class="text-warm-600 text-sm leading-relaxed">{stage.description}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-warm-600 text-sm mt-12 flex items-center justify-center gap-2">
      <Icon name="check" class="w-5 h-5" />
      {t.note}
    </p>
  </div>
</section>
