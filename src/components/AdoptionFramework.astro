---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].framework;
---
<section id="parcours" class="relative py-24 bg-gradient-to-b from-white to-brand-50/40 overflow-hidden">
  <div class="bg-dot-grid absolute inset-0 opacity-[0.05] pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-5xl mx-auto px-6">
    <div data-reveal class="text-center mb-12">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-brand-600 mb-3">{t.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg max-w-2xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <div data-reveal-group class="grid sm:grid-cols-2 gap-6">
      {t.domains.map((domain) => (
        <div data-reveal class="bg-white border border-warm-200 rounded-2xl p-7 hover:border-brand-300 hover:shadow-sm transition-all">
          <div class="w-12 h-12 mb-5 flex items-center justify-center rounded-xl bg-brand-50">
            <Icon name={domain.icon} class="w-6 h-6" />
          </div>
          <h3 class="text-warm-900 font-semibold text-lg mb-2">{domain.title}</h3>
          <p class="text-warm-600 text-sm leading-relaxed">{domain.description}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-warm-600 text-sm mt-10 flex items-center justify-center gap-2">
      <Icon name="check" class="w-5 h-5" />
      {t.note}
    </p>
  </div>
</section>
