---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].services;
---
<section id="services" class="py-24 bg-warm-50">
  <div class="max-w-6xl mx-auto px-6">
    <div data-reveal class="text-center mb-16">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-brand-600 mb-3">{t.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg max-w-xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <div data-reveal-group class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.items.map((service) => (
        <div data-reveal class="bg-white border border-warm-200 rounded-2xl overflow-hidden hover:border-brand-300 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col">
          <div class="relative">
            <img
              src={service.image}
              alt=""
              width="700"
              height="420"
              class="w-full h-40 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/50 to-transparent mix-blend-multiply" aria-hidden="true"></div>
            <div class="absolute -bottom-4 left-5 w-10 h-10 flex items-center justify-center rounded-xl bg-white shadow-md border border-warm-100">
              <Icon name={service.icon} class="w-5 h-5" />
            </div>
          </div>
          <div class="p-6 pt-7 flex flex-col flex-1">
            <h3 class="text-warm-900 font-semibold text-lg mb-2">
              {service.title}
            </h3>
            <p class="text-warm-600 text-sm leading-relaxed mb-4">{service.description}</p>
            <ul class="space-y-2 mt-auto pt-4 border-t border-warm-100">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-sm text-warm-700">
                  <Icon name="check" class="w-4 h-4 mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
