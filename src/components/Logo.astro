---
interface Props { class?: string; tone?: 'ink' | 'paper' }
const { class: cls = '', tone = 'ink' } = Astro.props;
const base = tone === 'paper' ? 'text-paper' : 'text-ink';
---
<span class={`font-display font-bold tracking-tight ${base} ${cls}`}>
  Dramis<span class="text-accent">Info</span>
</span>
