---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].useCases;
---
<section id="cas" class="py-24 bg-warm-50">
  <div class="max-w-6xl mx-auto px-6">
    <div data-reveal class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg max-w-xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <div data-reveal-group class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.items.map(item => (
        <div data-reveal class="flex items-start gap-4 bg-white border border-warm-200 rounded-2xl p-6 hover:border-brand-300 hover:shadow-md hover:-translate-y-1 transition-all">
          <div class="w-11 h-11 shrink-0 flex items-center justify-center rounded-xl bg-brand-50">
            <Icon name={item.icon} class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-warm-900 font-semibold mb-1.5 leading-snug">{item.title}</h3>
            <p class="text-warm-600 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
