---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
---
<section class="relative flex items-center pt-16 overflow-hidden bg-gradient-to-b from-brand-50 via-warm-50 to-white">
  <!-- Soft decorative shape -->
  <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-brand-100/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-4xl mx-auto px-6 py-24 md:py-32 text-center">
    <span class="inline-flex items-center gap-2 bg-white border border-warm-200 text-warm-700 text-sm font-medium px-4 py-1.5 rounded-full mb-8 shadow-sm">
      <span class="w-2 h-2 bg-brand-500 rounded-full"></span>
      {t.badge}
    </span>

    <h1 class="text-4xl md:text-6xl font-bold text-warm-900 leading-tight tracking-tight mb-6">
      {t.titleLine1}<br />
      <span class="text-brand-600">{t.titleHighlight}</span>
    </h1>

    <p class="text-lg md:text-xl text-warm-600 max-w-2xl mx-auto mb-10 leading-relaxed">
      {t.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3.5 rounded-xl transition-colors text-base shadow-sm"
      >
        {t.ctaPrimary}
      </a>
      <a
        href="#demarche"
        class="text-warm-700 hover:text-warm-900 font-medium px-8 py-3.5 rounded-xl border border-warm-200 hover:border-warm-600 bg-white transition-colors text-base"
      >
        {t.ctaSecondary}
      </a>
    </div>

    <p class="text-warm-600 text-sm mt-8">
      {t.reassurance}
    </p>
  </div>
</section>
