---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
---
<section class="relative overflow-hidden bg-gradient-to-b from-navy-900 via-navy-900 to-navy-800">
  <!-- Soft decorative glow -->
  <div class="hero-orb absolute -top-24 right-0 w-[500px] h-[500px] bg-brand-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="text-center md:text-left">
      <span data-animate style="--delay:0ms" class="inline-flex items-center gap-2 bg-white/5 border border-white/15 text-navy-100 text-sm font-medium px-4 py-1.5 rounded-full mb-8">
        <span class="w-2 h-2 bg-brand-400 rounded-full"></span>
        {t.badge}
      </span>

      <h1 data-animate style="--delay:90ms" class="text-5xl md:text-6xl font-bold text-white leading-[1.05] tracking-tighter mb-6">
        {t.titleLine1}<br />
        <span class="relative inline-block text-brand-400">
          {t.titleHighlight}
          <svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true" class="absolute left-0 -bottom-2 w-full h-3 text-brand-300">
            <path d="M2 10.5C60 2 140 2 150 8C160 14 240 3 298 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
          </svg>
        </span>
      </h1>

      <p data-animate style="--delay:180ms" class="text-lg text-navy-200 max-w-xl mx-auto md:mx-0 mb-10 leading-relaxed">
        {t.subtitle}
      </p>

      <div data-animate style="--delay:270ms" class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
        <a
          href="#contact"
          class="bg-brand-600 hover:bg-brand-500 text-white font-semibold px-8 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-md text-base shadow-sm"
        >
          {t.ctaPrimary}
        </a>
        <a
          href="#parcours"
          class="text-navy-100 hover:text-white font-medium px-8 py-3.5 rounded-xl border border-white/20 hover:border-white/40 bg-white/5 transition-all hover:-translate-y-0.5 text-base"
        >
          {t.ctaSecondary}
        </a>
      </div>

      <p data-animate style="--delay:360ms" class="text-navy-200 text-sm mt-8">
        {t.reassurance}
      </p>
    </div>

    <div data-animate style="--delay:180ms" class="relative rounded-3xl overflow-hidden shadow-xl shadow-navy-900/30 border border-white/10">
      <img
        src="/images/hero-datacenter.jpg"
        alt={t.imageAlt}
        width="1000"
        height="1000"
        class="w-full aspect-square object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-brand-900/30 via-navy-900/10 to-transparent mix-blend-multiply" aria-hidden="true"></div>
    </div>
  </div>
</section>
