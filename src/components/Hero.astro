---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
---
<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-warm-50 to-white">
  <!-- Soft decorative shape -->
  <div class="hero-orb absolute -top-24 right-0 w-[500px] h-[500px] bg-brand-100/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="text-center md:text-left">
      <span data-animate style="--delay:0ms" class="inline-flex items-center gap-2 bg-white border border-warm-200 text-warm-700 text-sm font-medium px-4 py-1.5 rounded-full mb-8 shadow-sm">
        <span class="w-2 h-2 bg-brand-500 rounded-full"></span>
        {t.badge}
      </span>

      <h1 data-animate style="--delay:90ms" class="text-4xl md:text-5xl font-bold text-warm-900 leading-tight tracking-tight mb-6">
        {t.titleLine1}<br />
        <span class="text-brand-600">{t.titleHighlight}</span>
      </h1>

      <p data-animate style="--delay:180ms" class="text-lg text-warm-600 max-w-xl mx-auto md:mx-0 mb-10 leading-relaxed">
        {t.subtitle}
      </p>

      <div data-animate style="--delay:270ms" class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
        <a
          href="#contact"
          class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-md text-base shadow-sm"
        >
          {t.ctaPrimary}
        </a>
        <a
          href="#parcours"
          class="text-warm-700 hover:text-warm-900 font-medium px-8 py-3.5 rounded-xl border border-warm-200 hover:border-warm-600 bg-white transition-all hover:-translate-y-0.5 text-base"
        >
          {t.ctaSecondary}
        </a>
      </div>

      <p data-animate style="--delay:360ms" class="text-warm-600 text-sm mt-8">
        {t.reassurance}
      </p>
    </div>

    <div data-animate style="--delay:180ms" class="relative">
      <img
        src="/images/hero-datacenter.jpg"
        alt={t.imageAlt}
        width="1000"
        height="1000"
        class="w-full aspect-square object-cover rounded-3xl shadow-xl shadow-navy-900/10 border border-white"
      />
    </div>
  </div>
</section>
