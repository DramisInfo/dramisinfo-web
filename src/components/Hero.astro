---
---
<section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-brand-900/30 pointer-events-none" aria-hidden="true"></div>
  <!-- Decorative blur orb -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-brand-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-24 text-center">
    <span class="inline-flex items-center gap-2 bg-brand-900/50 border border-brand-700/50 text-brand-300 text-sm font-medium px-4 py-1.5 rounded-full mb-8">
      <span class="w-2 h-2 bg-brand-400 rounded-full animate-pulse"></span>
      Agence Intelligence Artificielle
    </span>

    <h1 class="text-5xl md:text-7xl font-bold text-white leading-tight tracking-tight mb-6">
      L'IA au service<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-violet-400">
        de votre croissance
      </span>
    </h1>

    <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-12 leading-relaxed">
      DramisInfo conçoit et intègre des solutions d'intelligence artificielle sur mesure
      pour automatiser vos processus, amplifier vos équipes et accélérer vos résultats.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3.5 rounded-xl transition-colors text-base shadow-lg shadow-brand-900/40"
      >
        Démarrer un projet
      </a>
      <a
        href="#services"
        class="text-slate-300 hover:text-white font-medium px-8 py-3.5 rounded-xl border border-slate-700 hover:border-slate-500 transition-colors text-base"
      >
        Voir nos services
      </a>
    </div>
  </div>
</section>
