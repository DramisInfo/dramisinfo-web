---
import { ui, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].hero;
---
<section class="border-b border-rule">
  <div class="page grid gap-x-10 py-20 md:grid-cols-[7rem_1fr] md:py-28">
    <p class="mb-6 font-mono text-[11px] uppercase tracking-label text-ink-3 md:mb-0 md:pt-3">
      {t.label}
    </p>

    <div>
      <h1 data-reveal class="max-w-[19ch] text-[40px] font-bold leading-[1.05] sm:text-[58px] lg:text-[68px]">
        {t.titleA} <span class="text-accent">{t.titleAccent}</span> {t.titleB}
      </h1>

      <p data-reveal class="mt-8 max-w-prose text-[18px] leading-relaxed text-ink-2">
        {t.lead}
      </p>

      <div data-reveal class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="#contact" class="btn-primary">{t.ctaPrimary}</a>
        <a href="#demarche" class="btn-ghost">{t.ctaSecondary}</a>
      </div>

      <p data-reveal class="mt-5 font-mono text-[12px] text-ink-3">{t.note}</p>

      <dl data-reveal class="mt-16 grid gap-px border border-rule bg-rule sm:grid-cols-3">
        {t.stats.map((s) => (
          <div class="bg-paper px-5 py-6">
            <dt class="font-display text-[34px] font-bold leading-none tracking-tight text-ink tnum">
              {s.value}<span class="ml-1.5 text-[15px] font-medium text-accent-deep">{s.unit}</span>
            </dt>
            <dd class="mt-3 text-[14px] leading-snug text-ink-3">{s.caption}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
