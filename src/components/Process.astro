---
import SectionHead from './SectionHead.astro';
import { ui, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].process;
---
<section id="demarche" class="border-b border-rule py-20 md:py-28">
  <div class="page">
    <SectionHead num={t.num} label={t.label} title={t.title} lead={t.lead} />

    <ol class="mt-14 grid gap-px border border-rule bg-rule md:grid-cols-3">
      {t.steps.map((step, i) => (
        <li data-reveal class="bg-paper p-7 md:p-8">
          <span class="font-mono text-[12px] text-accent-deep tnum">{`0${i + 1}`}</span>
          <h3 class="mt-5 text-[20px] font-semibold leading-snug">{step.title}</h3>
          <p class="mt-3 text-[15.5px] leading-relaxed text-ink-3">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
