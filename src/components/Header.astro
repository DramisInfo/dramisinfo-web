---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui, type Lang } from '@/i18n/ui';
import { getPosts } from '@/lib/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].nav;
const b = ui[lang].blog;
const home = lang === 'fr' ? '/' : '/en/';

// Le lien vers le blogue n'apparaît que s'il y a quelque chose à lire :
// une étagère vide fait plus de tort que pas d'étagère du tout.
const posts = await getPosts(lang);
const blogHref = lang === 'fr' ? '/blogue/' : '/en/blog/';
const navLinks = posts.length
  ? [...t.items, { label: b.nav, href: blogHref }]
  : [...t.items];
---
<header data-header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur">
  <div class="page flex h-16 items-center justify-between gap-6">
    <a href={home} class="shrink-0" aria-label="DramisInfo">
      <Logo class="text-[19px]" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t.menu}>
      {navLinks.map((item) => (
        <a
          href={item.href.startsWith('#') ? `${home}${item.href}` : item.href}
          class="font-display text-[14px] font-medium text-ink-3 transition-colors hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-5">
      <LanguageSwitcher lang={lang} />
      <a href={`${home}#contact`} class="bg-accent px-4 py-2 font-display text-[14px] font-semibold text-white transition-colors hover:bg-accent-deep">
        {t.cta}
      </a>
    </div>
  </div>
</header>
