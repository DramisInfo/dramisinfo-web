---
const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'À propos', href: '#apropos' },
  { label: 'Contact', href: '#contact' },
];
---
<header class="fixed top-0 inset-x-0 z-50 bg-slate-950/80 backdrop-blur border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-white font-semibold text-lg tracking-tight">
      <span class="text-brand-500">Dramis</span>Info
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-slate-400 hover:text-white text-sm font-medium transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="#contact"
      class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
    >
      Parlons-en
    </a>
  </div>
</header>
