---
import SectionHead from './SectionHead.astro';
import { ui, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].build;
---
<section id="solutions" class="border-b border-rule bg-paper-2 py-20 md:py-28">
  <div class="page">
    <SectionHead num={t.num} label={t.label} title={t.title} lead={t.lead} />

    <div class="mt-14 grid gap-x-12 md:grid-cols-2">
      {t.items.map((item, i) => (
        <article data-reveal class="row grid grid-cols-[2.5rem_1fr] gap-4">
          <span class="font-mono text-[12px] text-accent tnum">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-[18px] font-semibold leading-snug">{item.title}</h3>
            <p class="mt-2 text-[15.5px] leading-relaxed text-ink-3">{item.body}</p>
            <ul class="mt-4 space-y-1.5">
              {item.points.map((p) => (
                <li class="flex gap-2.5 font-mono text-[12.5px] text-ink-3">
                  <span class="text-accent" aria-hidden="true">&rarr;</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
