---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].certifications;
---
<section id="certifications" class="py-24 bg-navy-50">
  <div class="max-w-6xl mx-auto px-6">
    <div data-reveal class="text-center mb-14">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-brand-600 mb-3">{t.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg max-w-xl mx-auto">
        {t.subheading}
      </p>
    </div>

    <!-- Certifications & formation : rangée de badges compacts -->
    <div data-reveal-group class="flex flex-wrap justify-center gap-3 mb-14">
      {t.items.map(item => (
        <div data-reveal class="flex items-center gap-2.5 bg-white border border-warm-200 rounded-full pl-2.5 pr-4 py-2">
          <div class="w-7 h-7 shrink-0 flex items-center justify-center rounded-full bg-brand-50">
            <Icon name={item.icon} class="w-4 h-4" />
          </div>
          <div class="text-left">
            <span class="block text-warm-900 font-semibold text-sm leading-tight">{item.title}</span>
            <span class="block text-warm-500 text-xs leading-tight">{item.subtitle}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Reconnaissances : panneau mis en évidence -->
    <div data-reveal class="bg-navy-900 rounded-3xl p-8 md:p-10">
      <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-brand-400 mb-6">{t.awardsLabel}</span>
      <div data-reveal-group class="grid md:grid-cols-3 gap-8">
        {t.awards.map(award => (
          <div data-reveal class="border-l-2 border-brand-500 pl-5">
            <h3 class="text-white font-semibold text-lg leading-snug">{award.title}</h3>
            <span class="block text-brand-300 text-xs font-medium mb-2">{award.subtitle}</span>
            <p class="text-navy-200 text-sm leading-relaxed">{award.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
