---
import Icon from './Icon.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;
---
<section id="apropos" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div data-reveal>
        <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-6">
          {t.heading}
        </h2>
        <div class="space-y-4 text-warm-600 leading-relaxed">
          <p>{t.p1}</p>
          <p>{t.p2}</p>
          <p>{t.p3}</p>
        </div>
      </div>

      <!-- Values -->
      <div data-reveal-group class="space-y-5">
        {t.values.map(value => (
          <div data-reveal class="bg-warm-50 border border-warm-200 rounded-2xl p-6 hover:border-brand-300 hover:shadow-sm transition-all">
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-6 h-6 mt-0.5 shrink-0" />
              <div>
                <h3 class="text-warm-900 font-semibold mb-1">{value.title}</h3>
                <p class="text-warm-600 text-sm leading-relaxed">{value.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
