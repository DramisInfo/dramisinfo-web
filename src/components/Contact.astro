---
import SectionHead from './SectionHead.astro';
import { ui, coords, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].contact;
const thanks = lang === 'fr' ? '/merci/' : '/en/merci/';
---
<section id="contact" class="bg-paper-2 py-20 md:py-28">
  <div class="page">
    <SectionHead num={t.num} label={t.label} title={t.title} lead={t.lead} />

    <div class="mt-14 grid gap-x-10 md:grid-cols-[7rem_1fr]">
      <div></div>

      <div class="grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-16">
        <form
          data-reveal
          name="contact"
          method="POST"
          action={thanks}
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>{lang === 'fr' ? 'Ne remplissez pas ce champ' : 'Do not fill this in'}
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="field-label" for="name">{t.name} <span class="text-accent">*</span></label>
              <input class="field" id="name" name="name" type="text" required autocomplete="name" placeholder={t.namePh} />
            </div>
            <div>
              <label class="field-label" for="email">{t.email} <span class="text-accent">*</span></label>
              <input class="field" id="email" name="email" type="email" required autocomplete="email" placeholder={t.emailPh} />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="field-label" for="company">{t.company}</label>
              <input class="field" id="company" name="company" type="text" autocomplete="organization" placeholder={t.companyPh} />
            </div>
            <div>
              <label class="field-label" for="phone">{t.phone}</label>
              <input class="field" id="phone" name="phone" type="tel" autocomplete="tel" placeholder={t.phonePh} />
            </div>
          </div>

          <div>
            <label class="field-label" for="sector">{t.sector}</label>
            <select class="field appearance-none" id="sector" name="sector">
              <option value="" selected>{t.sectorPh}</option>
              {t.sectorOpts.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div>
            <label class="field-label" for="message">{t.message} <span class="text-accent">*</span></label>
            <textarea class="field resize-none" id="message" name="message" rows="5" required placeholder={t.messagePh}></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">{t.submit}</button>
        </form>

        <aside data-reveal class="border-t border-rule pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
          <h3 class="label">{t.direct}</h3>
          <ul class="mt-4 space-y-3 font-mono text-[13.5px]">
            <li>
              <a href={coords.phoneHref} class="text-ink transition-colors hover:text-accent">{coords.phone}</a>
            </li>
            <li>
              <a data-eu={coords.emailUser} data-ed={coords.emailDomain} class="text-ink transition-colors hover:text-accent"></a>
            </li>
            <li class="text-ink-3">{coords.city}</li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>
