---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].contact;
---
<section id="contact" class="py-24 bg-warm-50">
  <div data-reveal class="max-w-2xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-warm-900 mb-4">{t.heading}</h2>
      <p class="text-warm-600 text-lg">{t.subtitle}</p>
    </div>

    <form
      name="prospect-survey"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-netlify-recaptcha="true"
      class="space-y-10"
    >
      <p class="hidden" aria-hidden="true">
        <label>Ne remplissez pas ce champ : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <input type="hidden" name="form-name" value="prospect-survey" />

      <!-- Section 1 : Votre entreprise -->
      <fieldset class="space-y-4">
        <legend class="w-full text-xs font-semibold uppercase tracking-widest text-brand-600 border-b border-warm-200 pb-2 mb-4">{t.sec1}</legend>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-warm-700 mb-1.5">
              {t.name} <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="name"
              type="text"
              name="name"
              required
              placeholder={t.namePh}
              class="w-full bg-white border border-warm-200 text-warm-900 placeholder-warm-600/50 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-warm-700 mb-1.5">
              {t.email} <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder={t.emailPh}
              class="w-full bg-white border border-warm-200 text-warm-900 placeholder-warm-600/50 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="company" class="block text-sm font-medium text-warm-700 mb-1.5">
              {t.company} <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="company"
              type="text"
              name="company"
              required
              placeholder={t.companyPh}
              class="w-full bg-white border border-warm-200 text-warm-900 placeholder-warm-600/50 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors"
            />
          </div>
          <div>
            <label for="region" class="block text-sm font-medium text-warm-700 mb-1.5">{t.region}</label>
            <input
              id="region"
              type="text"
              name="region"
              placeholder={t.regionPh}
              class="w-full bg-white border border-warm-200 text-warm-900 placeholder-warm-600/50 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="secteur" class="block text-sm font-medium text-warm-700 mb-1.5">{t.industry}</label>
            <div class="relative">
              <select
                id="secteur"
                name="secteur"
                class="w-full bg-white border border-warm-200 text-warm-900 rounded-xl px-4 py-3 pr-10 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors appearance-none"
              >
                <option value="" disabled selected>{t.industryPh}</option>
                {t.industryOpts.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-warm-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
          <div>
            <label for="taille" class="block text-sm font-medium text-warm-700 mb-1.5">{t.size}</label>
            <div class="relative">
              <select
                id="taille"
                name="taille"
                class="w-full bg-white border border-warm-200 text-warm-900 rounded-xl px-4 py-3 pr-10 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors appearance-none"
              >
                <option value="" disabled selected>{t.sizePh}</option>
                {t.sizeOpts.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-warm-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </fieldset>

      <!-- Section 2 : Votre quotidien -->
      <fieldset class="space-y-4">
        <legend class="w-full text-xs font-semibold uppercase tracking-widest text-brand-600 border-b border-warm-200 pb-2 mb-4">{t.sec2}</legend>

        <div>
          <label for="temps" class="block text-sm font-medium text-warm-700 mb-1.5">{t.timeSpent}</label>
          <div class="relative">
            <select
              id="temps"
              name="temps"
              class="w-full bg-white border border-warm-200 text-warm-900 rounded-xl px-4 py-3 pr-10 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors appearance-none"
            >
              <option value="" disabled selected>{t.timeSpentPh}</option>
              {t.timeOpts.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-warm-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <div>
          <p class="block text-sm font-medium text-warm-700 mb-2">{t.maturity}</p>
          <div class="space-y-2">
            {t.maturityOpts.map((opt) => (
              <label class="flex items-center gap-3 p-3.5 rounded-xl border border-warm-200 bg-white cursor-pointer hover:border-brand-400 has-[input:checked]:border-brand-500 has-[input:checked]:bg-brand-50 transition-colors">
                <input
                  type="radio"
                  name="maturite"
                  value={opt}
                  class="w-4 h-4 flex-shrink-0 border-warm-300 text-brand-600 focus:ring-brand-500 focus:ring-offset-0"
                />
                <span class="text-sm text-warm-800 leading-snug">{opt}</span>
              </label>
            ))}
          </div>
        </div>
      </fieldset>

      <!-- Section 3 : Votre situation -->
      <fieldset class="space-y-4">
        <legend class="w-full text-xs font-semibold uppercase tracking-widest text-brand-600 border-b border-warm-200 pb-2 mb-4">{t.sec3}</legend>

        <div>
          <p class="block text-sm font-medium text-warm-700 mb-2">{t.readiness}</p>
          <div class="space-y-2">
            {t.readinessOpts.map((opt) => (
              <label class="flex items-center gap-3 p-3.5 rounded-xl border border-warm-200 bg-white cursor-pointer hover:border-brand-400 has-[input:checked]:border-brand-500 has-[input:checked]:bg-brand-50 transition-colors">
                <input
                  type="radio"
                  name="demarche"
                  value={opt}
                  class="w-4 h-4 flex-shrink-0 border-warm-300 text-brand-600 focus:ring-brand-500 focus:ring-offset-0"
                />
                <span class="text-sm text-warm-800 leading-snug">{opt}</span>
              </label>
            ))}
          </div>
        </div>

        <div>
          <label for="commentaires" class="block text-sm font-medium text-warm-700 mb-1.5">{t.comments}</label>
          <textarea
            id="commentaires"
            name="commentaires"
            rows={3}
            placeholder={t.commentsPh}
            class="w-full bg-white border border-warm-200 text-warm-900 placeholder-warm-600/50 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors resize-none"
          ></textarea>
        </div>
      </fieldset>

      <!-- reCAPTCHA injecté par Netlify au déploiement -->
      <div data-netlify-recaptcha class="flex justify-center"></div>

      <button
        type="submit"
        class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-md text-sm shadow-sm"
      >
        {t.submit}
      </button>
    </form>

    <p class="text-warm-600 text-xs mt-6 text-center">
      {t.prefer}
      <!-- Courriel reconstruit côté client pour ne jamais apparaître en clair -->
      <a data-eu="info" data-ed="dramisinfo.com" class="text-brand-600 hover:text-brand-700 font-medium transition-colors"></a>
    </p>
  </div>
</section>

<script>
  function initEmailLinks() {
    document.querySelectorAll<HTMLAnchorElement>('a[data-eu][data-ed]').forEach((a) => {
      const addr = `${a.dataset.eu}@${a.dataset.ed}`;
      a.href = `mailto:${addr}`;
      if (!a.textContent?.trim()) a.textContent = addr;
    });
  }
  initEmailLinks();
  document.addEventListener('astro:page-load', initEmailLinks);
</script>
