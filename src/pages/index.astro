---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Services from '@/components/Services.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout
  title="DramisInfo — Automatisation et productivité pour les entreprises"
  description="DramisInfo aide les entreprises à gagner du temps en simplifiant et automatisant leurs tâches du quotidien. Des solutions simples et concrètes, avec ou sans intelligence artificielle."
>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <Services />
    <About />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
