---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout lang="fr" title="Page introuvable — DramisInfo" description="Cette page n'existe pas.">
  <Header lang="fr" />
  <main id="main" class="page flex min-h-[62vh] items-center py-24">
    <div class="max-w-prose">
      <p class="font-mono text-[11px] uppercase tracking-label text-accent tnum">404</p>
      <h1 class="mt-4 text-[38px] leading-tight sm:text-[46px]">Cette page n'existe pas.</h1>
      <p class="mt-5 text-[17px] leading-relaxed text-ink-2">
        Le lien est peut-être périmé. Le reste du site se trouve à l'accueil.
      </p>
      <a href="/" class="btn-ghost mt-9">Retour à l'accueil</a>
    </div>
  </main>
  <Footer lang="fr" />
</BaseLayout>
