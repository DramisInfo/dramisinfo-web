---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import ValueProposition from '@/components/ValueProposition.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Services from '@/components/Services.astro';
import AdoptionFramework from '@/components/AdoptionFramework.astro';
import UseCases from '@/components/UseCases.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import { ui } from '@/i18n/ui';

const lang = 'en' as const;
const t = ui[lang];
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <ValueProposition lang={lang} />
    <HowItWorks lang={lang} />
    <Services lang={lang} />
    <AdoptionFramework lang={lang} />
    <UseCases lang={lang} />
    <About lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
